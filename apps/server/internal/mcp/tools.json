  {
    "name": "search_articles",
    "description": "Search articles in the LitRadar index.",
    "inputSchema": {
      "$defs": {
        "StringOrStrings": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "items": {
                "type": "string"
              },
              "type": "array"
            }
          ]
        }
      },
      "$schema": "https://json-schema.org/draft/2020-12/schema",
      "properties": {
        "abs_rating": {
          "description": "Exact ABS grades; 4* is a literal grade, not a wildcard.",
          "items": {
            "type": "string"
          },
          "type": ["array", "null"]
        },
        "area": {
          "anyOf": [
            {
              "$ref": "#/$defs/StringOrStrings"
            },
            {
              "type": "null"
            }
          ]
        },
        "cursor": {
          "type": ["string", "null"]
        },
        "date_from": {
          "type": ["string", "null"]
        },
        "date_to": {
          "type": ["string", "null"]
        },
        "db": {
          "type": ["string", "null"]
        },
        "doi": {
          "type": ["string", "null"]
        },
        "fms_rating": {
          "description": "Exact FMS grades.",
          "items": {
            "type": "string"
          },
          "type": ["array", "null"]
        },
        "fmscn_rating": {
          "description": "Exact FMS China grades.",
          "items": {
            "type": "string"
          },
          "type": ["array", "null"]
        },
        "in_press": {
          "type": ["boolean", "null"]
        },
        "include_total": {
          "type": ["boolean", "null"]
        },
        "issue_id": {
          "format": "int64",
          "type": ["integer", "null"]
        },
        "journal_id": {
          "anyOf": [
            {
              "$ref": "#/$defs/StringOrStrings"
            },
            {
              "type": "null"
            }
          ]
        },
        "limit": {
          "format": "int64",
          "type": ["integer", "null"]
        },
        "offset": {
          "format": "int64",
          "type": ["integer", "null"]
        },
        "open_access": {
          "type": ["boolean", "null"]
        },
        "pmid": {
          "type": ["string", "null"]
        },
        "q": {
          "type": ["string", "null"]
        },
        "search_mode": {
          "type": ["string", "null"]
        },
        "sort": {
          "type": ["string", "null"]
        },
        "utd_rating": {
          "description": "Exact UTD grades; OR within a system, AND across systems and other filters.",
          "items": {
            "type": "string"
          },
          "type": ["array", "null"]
        },
        "year": {
          "format": "int64",
          "type": ["integer", "null"]
        }
      },
      "type": "object"
    }
  }
