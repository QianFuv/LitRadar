{
  "name": "litradar-frontend",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vp dev --host 127.0.0.1 --port 8000 --strictPort",
    "build": "vp build",
    "build:native": "vp build --mode native",
    "preview": "vp preview --host 127.0.0.1 --port 8000 --strictPort",
    "check": "vp check",
    "check:fix": "vp check --fix",
    "lint": "vp lint",
    "typecheck": "vp check --no-fmt --no-lint",
    "format": "vp fmt",
    "format:check": "vp fmt --check",
    "knip": "knip",
    "generate:api": "node scripts/check-generated-api.mjs --write",
    "generate:api:check": "node scripts/check-generated-api.mjs",
    "test": "pnpm test:unit",
    "test:unit": "vp test run --project unit-jsdom",
    "test:browser-components": "vp test run --project component-browser --browser.headless",
    "test:coverage": "vp test run --project unit-jsdom --coverage",
    "test:watch": "vp test --project unit-jsdom",
    "test:e2e": "pnpm test:e2e:fixtures",
    "test:e2e:fixtures": "playwright test --config playwright.config.tsx",
    "test:e2e:full-stack": "pnpm build && node ../../server/scripts/build-go.mjs && node tests/e2e/support/full-stack-server.mjs"
  },
  "dependencies": {
    "@animate-ui/react": "^2.4.1",
    "@base-ui/react": "^1.9.0",
    "@stylexjs/stylex": "^0.19.1",
    "@tanstack/react-query": "^5.107.1",
    "@tanstack/react-router": "^1.170.46",
    "@wailsio/runtime": "3.1.0",
    "@xyflow/react": "^12.12.0",
    "d3-force": "^3.0.0",
    "lucide-react": "^0.563.0",
    "motion": "^14.9.0",
    "next-themes": "^0.4.6",
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "react-intersection-observer": "^10.0.2",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@babel/core": "^8.1.0",
    "@playwright/test": "^1.61.1",
    "@rolldown/plugin-babel": "^0.3.1",
    "@stylexjs/eslint-plugin": "^0.19.1",
    "@stylexjs/unplugin": "^0.19.1",
    "@tanstack/react-devtools": "^0.10.14",
    "@tanstack/react-query-devtools": "^5.107.1",
    "@tanstack/react-router-devtools": "^1.167.3",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.2",
    "@testing-library/user-event": "^14.6.1",
    "@types/d3-force": "^3.0.10",
    "@types/node": "^24",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@typescript/typescript6": "^6.0.2",
    "@vitejs/plugin-react": "^6.2.1",
    "@vitest/browser-playwright": "5.1.0",
    "@vitest/coverage-v8": "5.1.0",
    "babel-plugin-react-compiler": "^1.0.0",
    "browserslist": "^4.29.5",
    "jsdom": "^29.1.1",
    "knip": "^6.44.1",
    "lightningcss": "^1.33.0",
    "msw": "^2.15.0",
    "openapi-typescript": "^7.13.0",
    "oxlint-anti-slop": "^0.4.0",
    "typescript": "^7.0.2",
    "vite-plus": "1.5.1",
    "vitest": "5.1.0"
  }
}
