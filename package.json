{
  "name": "litradar",
  "private": true,
  "packageManager": "pnpm@12.16.1",
  "scripts": {
    "dev": "node scripts/dev.mjs",
    "build": "pnpm --filter litradar-frontend build",
    "check": "pnpm --filter litradar-frontend check",
    "lint": "pnpm --filter litradar-frontend lint",
    "typecheck": "pnpm --filter litradar-frontend typecheck",
    "test": "pnpm --filter litradar-frontend test",
    "e2e": "pnpm --filter litradar-frontend test:e2e",
    "generate:api": "pnpm --filter litradar-frontend generate:api",
    "generate:api:check": "pnpm --filter litradar-frontend generate:api:check"
  }
}
